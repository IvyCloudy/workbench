{
  "name": "testcase-viewer",
  "displayName": "TestCase Viewer",
  "version": "0.0.1",
  "description": "查看线上测试案例",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "testcaseViewer.unifiedEditor",
        "displayName": "测试案例编辑器",
        "selector": [
          {
            "filenamePattern": "**/测试任务/*/测试案例/**/*.csv"
          },
          {
            "filenamePattern": "**/测试任务/*/测试案例/**/*.yaml"
          },
          {
            "filenamePattern": "**/测试任务/*/测试案例/**/*.yml"
          },
          {
            "filenamePattern": "**/测试任务/*/测试案例/**/*.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "testcaseViewer.mindmapEditor",
        "displayName": "测试大纲思维导图",
        "selector": [
          {
            "filenamePattern": "**/测试大纲/**/*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "testcaseViewer.viewOnline",
        "title": "查看测试案例",
        "icon": "$(checklist)"
      },
      {
        "command": "testcaseViewer.openWithEditor",
        "title": "用测试案例编辑器打开"
      },
      {
        "command": "testcaseViewer.openWithText",
        "title": "用 Text Editor 打开"
      },
      {
        "command": "testcaseViewer.pushTestCaseFromExplorer",
        "title": "推送测试案例",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "testcaseViewer.revealBoundTask",
        "title": "定位绑定任务"
      },
      {
        "command": "testcaseViewer.createNewTestCase",
        "title": "新增测试案例",
        "icon": "$(add)",
        "category": "测试案例"
      },
      {
        "command": "testcaseViewer.createNewTestCaseQuick",
        "title": "新增测试案例",
        "icon": "$(add)",
        "category": "测试案例"
      },
      {
        "command": "testcaseViewer.openMindmap",
        "title": "用思维导图打开",
        "category": "测试大纲"
      },
      {
        "command": "testcaseViewer.openMindmapAsText",
        "title": "用 Text Editor 打开",
        "category": "测试大纲"
      },
      {
        "command": "testcaseViewer.exportMindmapToXmind",
        "title": "导出为 .xmind",
        "category": "测试大纲"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "testcaseViewer.viewOnline",
          "when": "testcaseViewer:showIcon",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "testcaseViewer.pushTestCaseFromExplorer",
          "when": "resourcePath =~ /测试任务[\\/][^\\/]+[\\/]测试案例[\\/].+\\.(csv|yaml|yml|json)$/i",
          "group": "2_workspace"
        },
        {
          "command": "testcaseViewer.createNewTestCase",
          "when": "resourcePath =~ /测试任务[\\/][^\\/]+[\\/]测试案例(?:[\\/]|$)/i && resourceExtname == ''",
          "group": "2_workspace@1"
        },
        {
          "command": "testcaseViewer.createNewTestCase",
          "when": "resourcePath =~ /测试任务[\\/][^\\/]+[\\/]测试案例[\\/].+\\.(csv|yaml|yml|json)$/i && resourceExtname != ''",
          "group": "2_workspace@2"
        },
        {
          "command": "testcaseViewer.openMindmap",
          "when": "resourcePath =~ /测试大纲[\\/].+\\.md$/i",
          "group": "2_workspace@3"
        },
        {
          "command": "testcaseViewer.exportMindmapToXmind",
          "when": "resourcePath =~ /测试大纲[\\/].+\\.md$/i",
          "group": "2_workspace@4"
        }
      ],
      "commandPalette": [
        {
          "command": "testcaseViewer.createNewTestCaseQuick",
          "when": "resourcePath =~ /测试任务[\\/][^\\/]+[\\/]测试案例(?:[\\/]|$)/i"
        },
        {
          "command": "testcaseViewer.openMindmap",
          "when": "resourcePath =~ /测试大纲[\\/].+\\.md$/i"
        },
        {
          "command": "testcaseViewer.openMindmapAsText",
          "when": "resourcePath =~ /测试大纲[\\/].+\\.md$/i"
        },
        {
          "command": "testcaseViewer.exportMindmapToXmind",
          "when": "resourcePath =~ /测试大纲[\\/].+\\.md$/i"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "boundTasks",
          "name": "已绑定任务"
        }
      ]
    },
    "configuration": {
      "title": "TestCase Viewer",
      "properties": {
        "testcaseViewer.apiUrl": {
          "type": "string",
          "default": "http://localhost:8081",
          "description": "查询线上案例的API接口地址"
        },
        "testcaseViewer.headerLabels": {
          "type": "object",
          "default": {
            "testcase_id": "用例ID",
            "testCaseNo": "用例编号",
            "testCaseName": "用例名称",
            "name": "名称",
            "title": "标题",
            "path": "路径",
            "module": "模块",
            "priority": "优先级",
            "type": "类型",
            "tags": "标签",
            "owner": "负责人",
            "creator": "创建人",
            "status": "状态",
            "preconditions": "前置条件",
            "precondition": "前置条件",
            "steps": "步骤",
            "step": "步骤",
            "operation": "操作",
            "data": "数据",
            "expected": "预期结果",
            "ui-expected": "UI预期",
            "api-expected": "接口预期",
            "db-expected": "数据库预期",
            "result": "结果",
            "remark": "备注",
            "description": "描述",
            "createTime": "创建时间",
            "updateTime": "更新时间"
          },
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "测试案例编辑器表头**中英映射**（仅用于显示，不会写入数据文件）。\n\n- key 为数据文件中的英文字段名，value 为中文显示名。\n- 优先级（高 → 低）：**工作区设置 > 用户设置 > 插件内置默认值**。\n- 同名 key 在高优先级中出现会覆盖低优先级；未配置的字段表头只显示英文 key。\n- 插件已内置常见字段（如 `testcase_id`、`path`、`priority`、`steps` 等），可直接覆盖或扩展。\n\n示例：\n```json\n{\n  \"testcase_id\": \"用例ID\",\n  \"path\": \"路径\"\n}\n```"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:mindmap-vendor && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:mindmap-vendor": "node scripts/build-mindmap-vendor.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "iconv-lite": "^0.7.2",
    "sm-crypto": "^0.3.7",
    "udsv": "^0.7.3",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.84.0",
    "esbuild": "^0.24.2",
    "simple-mind-map": "^0.14.0-fix.2",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  }
}
